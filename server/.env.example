# Copy to server/.env and fill in. Never commit the real .env file.
# Placeholders only. In production these are set in the Render dashboard
# (see docs/deployment.md); a blank line such as `S3_BUCKET=` means "not set".
NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/lms
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10

# Comma-separated browser origins allowed to call the API (no trailing slash).
# Production: https://<your-app>.vercel.app — https is required there.
CLIENT_ORIGINS=http://localhost:5173

# Cookie flags. COOKIE_SECURE defaults to true when NODE_ENV=production (false is refused there).
# COOKIE_SAMESITE=lax works because the client proxies /api (Vite in dev, Vercel rewrite in prod).
# COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Number of proxies in front of Express, used for the client IP that rate limits count.
# 0 in development. REQUIRED in production, with no default: measure it on the live
# deployment with PROXY_DIAGNOSTICS (docs/deployment.md, step 6). Never guess it.
TRUST_PROXY=0
# true exposes GET /api/v1/health/proxy for that measurement. Turn it off again afterwards.
PROXY_DIAGNOSTICS=false
# Shared secret between the Vercel /api route and the API. REQUIRED in production (32+ random
# characters; the same value as the ORIGIN_SECRET variable in the Vercel project). Vercel adds it
# to every proxied request as x-origin-secret at the edge; the API refuses any request without
# it (except GET /api/v1/health), so the Render URL can't be called directly. Never put it in
# client code or a VITE_ variable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave empty in development (the check is then off). For a local proxy with the check on,
# start the client with PROXY_ORIGIN_SECRET set to the same value (client/vite.config.js).
ORIGIN_SECRET=
# Only while rotating: the old value, accepted together with ORIGIN_SECRET (docs/deployment.md).
ORIGIN_SECRET_PREVIOUS=

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60
# File uploads per user per hour.
UPLOAD_RATE_LIMIT_MAX=30
LOG_LEVEL=info

# Where uploaded files are kept: `local` (development) or `s3` (required in production).
# Files are never served statically or from public bucket URLs: GET /api/v1/files/:id
# checks access first and streams the bytes.
STORAGE_DRIVER=local
# local: defaults to server/uploads. A relative path is resolved from the server directory.
# UPLOAD_DIR=

# s3: a PRIVATE Cloudflare R2 bucket (or any S3-compatible store). Keep public access off.
# R2 endpoint: https://<account id>.r2.cloudflarestorage.com (no bucket in the URL).
# Use an R2 API token with "Object Read & Write" on this bucket only.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true: https://endpoint/bucket/key (R2, MinIO). false: https://bucket.endpoint/key.
S3_FORCE_PATH_STYLE=true

# Trainer account created by `npm run seed`.
SEED_ADMIN_NAME=Trainer
SEED_ADMIN_EMAIL=trainer@example.com
SEED_ADMIN_PASSWORD=

# Optional: creates 3 demo students (aarav/neha/kabir.demo@example.com) with sample
# enrollments when set. Leave empty to skip. Never set this in production.
SEED_DEMO_STUDENT_PASSWORD=
