# Copy to server/.env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10

# Comma-separated browser origins allowed to call the API.
# Production: https://<your-app>.vercel.app
CLIENT_ORIGINS=http://localhost:5173

# Cookie flags. COOKIE_SECURE defaults to true when NODE_ENV=production.
# COOKIE_SAMESITE=lax works because the client proxies /api (Vite in dev, Vercel rewrite in prod).
# COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of Express (Vercel + Render in production).
TRUST_PROXY=0

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Trainer account created by `npm run seed`.
SEED_ADMIN_NAME=Trainer
SEED_ADMIN_EMAIL=trainer@example.com
SEED_ADMIN_PASSWORD=

# Optional: creates 3 demo students (aarav/neha/kabir.demo@example.com) with sample
# enrollments when set. Leave empty to skip. Never set this in production.
SEED_DEMO_STUDENT_PASSWORD=
